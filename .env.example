# Optional development overrides. Production builds default to the signed
# catalog at https://lumensource.dev/v2/model-list.json and its compiled-in
# Ed25519 public key.
LUMEN_SOURCE_CATALOG_URL=https://catalog.example.com/v1/catalog.json
LUMEN_SOURCE_CATALOG_SIGNATURE_URL=https://catalog.example.com/v1/catalog.json.sig
LUMEN_SOURCE_CATALOG_PUBLIC_KEY=BASE64_ENCODED_32_BYTE_ED25519_PUBLIC_KEY

# Optional development override. Production builds send explicitly opted-in,
# weekly aggregate reports to https://lumensource.dev/v2/telemetry.
LUMEN_SOURCE_TELEMETRY_URL=https://telemetry.example.com/v2/telemetry
